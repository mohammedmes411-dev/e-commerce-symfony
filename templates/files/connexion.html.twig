{% extends "base.html.twig" %}

{% block title %}Connexion - MarocShop{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
        }

        .carte-auth {
            border: none;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
        }

        .panneau-connexion {
            background: #ffffff;
            padding: 2.5rem;
        }

        .panneau-inscription {
            background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%);
            padding: 2.5rem;
            color: white;
        }

        .titre-section {
            font-weight: 700;
            font-size: 1.6rem;
            margin-bottom: 1.5rem;
            color: #1a1a2e;
        }

        .titre-section-clair {
            font-weight: 700;
            font-size: 1.6rem;
            margin-bottom: 1.5rem;
            color: #ffffff;
        }

        .champ-formulaire {
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            padding: 0.7rem 1rem;
            transition: border-color 0.2s;
        }

        .champ-formulaire:focus {
            border-color: #ea580c;
            box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.15);
        }

        .champ-formulaire-clair {
            border: 2px solid rgba(255,255,255,0.4);
            border-radius: 8px;
            padding: 0.7rem 1rem;
            background: rgba(255,255,255,0.15);
            color: white;
        }

        .champ-formulaire-clair::placeholder {
            color: rgba(255,255,255,0.6);
        }

        .champ-formulaire-clair:focus {
            border-color: rgba(255,255,255,0.8);
            background: rgba(255,255,255,0.25);
            box-shadow: none;
            color: white;
        }

        .bouton-connexion {
            background: linear-gradient(135deg, #ea580c, #c2410c);
            border: none;
            border-radius: 8px;
            padding: 0.75rem;
            font-weight: 600;
            font-size: 1rem;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .bouton-connexion:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(234, 88, 12, 0.4);
        }

        .bouton-inscription {
            background: white;
            color: #ea580c;
            border: none;
            border-radius: 8px;
            padding: 0.75rem;
            font-weight: 700;
            font-size: 1rem;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .bouton-inscription:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.2);
            background: #fff7ed;
            color: #c2410c;
        }

        .pied-page {
            background: #1a1a2e;
            color: #94a3b8;
            padding: 2rem 0;
            margin-top: 3rem;
        }

        .nom-boutique-pied {
            color: #fdba74;
            font-weight: 700;
            font-size: 1.2rem;
        }
    </style>
{% endblock %}

{% block body %}
{{ parent() }}

    <!-- Section Connexion / Inscription -->
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="carte-auth">
                    <div class="row g-0">

                        <!-- Panneau Gauche - Connexion -->
                        <div class="col-md-6 panneau-connexion">
                            <h2 class="titre-section">🔐 Connexion</h2>

                            {% if error %}
                                <div class="alert alert-danger rounded-3">
                                    {{ error.messageKey | trans(error.messageData, 'security') }}
                                </div>
                            {% endif %}

                            <form action="{{ path('ecommerce_login') }}" method="POST">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                                <div class="mb-3">
                                    <label for="adresse_email" class="form-label fw-semibold">Adresse e-mail</label>
                                    <input type="email"
                                           class="form-control champ-formulaire"
                                           id="adresse_email"
                                           name="_username"
                                           value="{{ last_username }}"
                                           placeholder="votre@email.com"
                                           required>
                                </div>

                                <div class="mb-3">
                                    <label for="mot_de_passe" class="form-label fw-semibold">Mot de passe</label>
                                    <input type="password"
                                           class="form-control champ-formulaire"
                                           id="mot_de_passe"
                                           name="_password"
                                           placeholder="••••••••"
                                           required>
                                </div>

                                <div class="mb-3 form-check">
                                    <input type="checkbox" class="form-check-input" id="se_souvenir" name="_remember_me">
                                    <label class="form-check-label" for="se_souvenir">Se souvenir de moi</label>
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn btn-success bouton-connexion">
                                        Se connecter →
                                    </button>
                                </div>
                            </form>

                            <div class="mt-3 text-center">
                                <a href="#" class="text-decoration-none text-muted small">Mot de passe oublié ?</a>
                            </div>
                        </div>

                        <!-- Panneau Droite - Inscription -->
                        <div class="col-md-6 panneau-inscription">
                            <h2 class="titre-section-clair">✨ Créer un compte</h2>

                            <form action="{{ path('ecommerce_register') }}" method="POST" id="formulaire-inscription">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">

                                <div class="mb-3">
                                    <label for="nom_complet" class="form-label fw-semibold">Nom complet</label>
                                    <input type="text"
                                           class="form-control champ-formulaire-clair"
                                           id="nom_complet"
                                           name="fullName"
                                           placeholder="Votre nom complet"
                                           required>
                                </div>

                                <div class="mb-3">
                                    <label for="email_inscription" class="form-label fw-semibold">Adresse e-mail</label>
                                    <input type="email"
                                           class="form-control champ-formulaire-clair"
                                           id="email_inscription"
                                           name="email"
                                           placeholder="votre@email.com"
                                           required>
                                </div>

                                <div class="mb-3">
                                    <label for="mdp_inscription" class="form-label fw-semibold">Mot de passe</label>
                                    <input type="password"
                                           class="form-control champ-formulaire-clair"
                                           id="mdp_inscription"
                                           name="password"
                                           placeholder="Créez un mot de passe"
                                           required>
                                </div>

                                <div class="mb-3">
                                    <label for="confirmer_mdp" class="form-label fw-semibold">Confirmer le mot de passe</label>
                                    <input type="password"
                                           class="form-control champ-formulaire-clair"
                                           id="confirmer_mdp"
                                           name="confirmPassword"
                                           placeholder="Confirmez votre mot de passe"
                                           required>
                                </div>

                                <div class="mb-4 form-check">
                                    <input type="checkbox" class="form-check-input" id="conditions_utilisation" required>
                                    <label class="form-check-label small" for="conditions_utilisation">
                                        J'accepte les <a href="#" class="text-white fw-bold">Conditions d'utilisation</a>
                                    </label>
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn bouton-inscription">
                                        Créer mon compte ✓
                                    </button>
                                </div>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pied de page -->
    <footer class="pied-page">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="nom-boutique-pied mb-1">🛒 MarocShop</p>
                    <p class="mb-0 small">Des produits de qualité à prix accessibles</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0 small">&copy; 2026 MarocShop. Tous droits réservés.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

{% endblock %}