{% extends "base.html.twig" %}

{% block title %}Catégories - MarocShop{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f1f5f9;
        }

        /* Section Héro */
        .section-hero {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            color: white;
            padding: 5rem 0;
        }

        .titre-hero {
            font-size: 3rem;
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 1.2rem;
        }

        .titre-hero span {
            color: #fdba74;
        }

        .sous-titre-hero {
            font-size: 1.1rem;
            color: #cbd5e1;
            margin-bottom: 2rem;
        }

        .bouton-hero-principal {
            background: linear-gradient(135deg, #ea580c, #c2410c);
            border: none;
            border-radius: 10px;
            color: white;
            padding: 0.85rem 2rem;
            font-weight: 700;
            text-decoration: none;
            transition: transform 0.2s, box-shadow 0.2s;
            display: inline-block;
        }

        .bouton-hero-principal:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(234, 88, 12, 0.4);
            color: white;
        }

        .bouton-hero-secondaire {
            background: transparent;
            border: 2px solid rgba(255,255,255,0.4);
            border-radius: 10px;
            color: white;
            padding: 0.85rem 2rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            display: inline-block;
        }

        .bouton-hero-secondaire:hover {
            border-color: #fdba74;
            color: #fdba74;
        }

        /* Section Catégories */
        .titre-section-categories {
            font-size: 2rem;
            font-weight: 800;
            color: #1a1a2e;
        }

        .sous-titre-section {
            color: #6b7280;
        }

        .carte-categorie {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 18px rgba(0,0,0,0.08);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            overflow: hidden;
        }

        .carte-categorie:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        }

        .corps-categorie {
            padding: 2rem 1.5rem;
            text-align: center;
        }

        .badge-nb-produits {
            background: #fef9c3;
            color: #ca8a04;
            font-weight: 700;
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
            font-size: 0.8rem;
            margin-bottom: 1rem;
            display: inline-block;
        }

        .nom-categorie {
            font-size: 1.3rem;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 0.75rem;
        }

        .exemples-categorie {
            color: #6b7280;
            font-size: 0.9rem;
            margin-bottom: 1.25rem;
        }

        .bouton-parcourir {
            background: transparent;
            border: 2px solid #ea580c;
            color: #ea580c;
            border-radius: 8px;
            padding: 0.5rem 1.2rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            display: inline-block;
        }

        .bouton-parcourir:hover {
            background: #ea580c;
            color: white;
        }

        /* Section Avantages */
        .section-avantages {
            background: white;
            padding: 4rem 0;
            margin-top: 4rem;
        }

        .carte-avantage {
            text-align: center;
            padding: 2rem;
        }

        .icone-avantage {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .titre-avantage {
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 0.5rem;
        }

        .description-avantage {
            color: #6b7280;
            font-size: 0.9rem;
        }

        /* Pied de page */
        .pied-page {
            background: #1a1a2e;
            color: #94a3b8;
            padding: 2rem 0;
        }

        .nom-boutique-pied {
            color: #fdba74;
            font-weight: 700;
            font-size: 1.2rem;
        }
    </style>
{% endblock %}

{% block body %}
    {{ parent() }}

    <!-- Section Héro -->
    <div class="section-hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <h1 class="titre-hero">
                        Bienvenue sur<br>
                        <span>MarocShop</span>
                    </h1>
                    <p class="sous-titre-hero">
                        Découvrez des milliers de produits de qualité à prix imbattables. Livraison rapide partout au Maroc.
                    </p>
                    <div class="d-flex gap-3 flex-wrap">
                        <a href="{{ path('ecommerce_browseProducts') }}" class="bouton-hero-principal">
                            🛍️ Acheter maintenant
                        </a>
                        <a href="#section-categories" class="bouton-hero-secondaire">
                            📂 Voir les catégories
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section Catégories -->
    <div class="container my-5" id="section-categories">
        <div class="text-center mb-5">
            <h2 class="titre-section-categories">📂 Acheter par catégorie</h2>
            <p class="sous-titre-section">Explorez notre large gamme de produits organisés par catégorie</p>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            {% for categorie in categories %}
                <div class="col">
                    <div class="carte-categorie card h-100">
                        <div class="corps-categorie">
                            <span class="badge-nb-produits">{{ categorie.nombreProduits }} Produits</span>
                            <h4 class="nom-categorie">{{ categorie.nom }}</h4>
                            <p class="exemples-categorie">{{ categorie.exemplesProduits }}</p>
                            <a href="{{ path('ecommerce_productsThroughCategory', { id: categorie.id }) }}"
                               class="bouton-parcourir">
                                Voir {{ categorie.nom }} →
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Section Avantages -->
    <div class="section-avantages">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="carte-avantage">
                        <div class="icone-avantage">🚚</div>
                        <h5 class="titre-avantage">Livraison gratuite</h5>
                        <p class="description-avantage">Pour toute commande supérieure à 500 MAD</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="carte-avantage">
                        <div class="icone-avantage">🔒</div>
                        <h5 class="titre-avantage">Paiement sécurisé</h5>
                        <p class="description-avantage">100% des transactions sont sécurisées</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="carte-avantage">
                        <div class="icone-avantage">↩️</div>
                        <h5 class="titre-avantage">Retours faciles</h5>
                        <p class="description-avantage">30 jours pour retourner votre commande</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pied de page -->
    <footer class="pied-page">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="nom-boutique-pied mb-1">🛒 MarocShop</p>
                    <p class="mb-0 small">Des produits de qualité à prix accessibles</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0 small">&copy; 2026 MarocShop. Tous droits réservés.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

{% endblock %}