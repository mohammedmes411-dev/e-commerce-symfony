{% extends "base.html.twig" %}

{% block title %}Nos Produits - MarocShop{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f1f5f9;
        }

        .titre-page {
            font-size: 2rem;
            font-weight: 800;
            color: #1a1a2e;
            border-left: 5px solid #ea580c;
            padding-left: 1rem;
            margin-bottom: 2rem;
        }

        .carte-produit {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            overflow: hidden;
        }

        .carte-produit:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.15);
        }

        .carte-produit .card-img-top {
            height: 200px;
            object-fit: cover;
        }

        .etiquette-categorie {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
        }

        .prix-produit {
            font-size: 1.2rem;
            font-weight: 700;
            color: #ea580c;
        }

        .bouton-details {
            background: linear-gradient(135deg, #ea580c, #c2410c);
            border: none;
            border-radius: 8px;
            color: white;
            padding: 0.5rem 1.2rem;
            font-weight: 600;
            transition: opacity 0.2s;
            text-decoration: none;
            display: inline-block;
        }

        .bouton-details:hover {
            opacity: 0.88;
            color: white;
        }

        .pied-page {
            background: #1a1a2e;
            color: #94a3b8;
            padding: 2rem 0;
            margin-top: 4rem;
        }

        .nom-boutique-pied {
            color: #fdba74;
            font-weight: 700;
            font-size: 1.2rem;
        }
    </style>
{% endblock %}

{% block body %}
    {{ parent() }}

    <!-- Section Liste des Produits -->
    <div class="container my-5">
        <h1 class="titre-page">📦 Nos Produits</h1>

        <div class="row row-cols-1 row-cols-md-3 g-4">

            <!-- Produit 1 -->
            <div class="col">
                <div class="card carte-produit h-100">
                    <img src="item.png" class="card-img-top" alt="Écouteurs sans fil">
                    <div class="card-body">
                        <span class="badge bg-primary etiquette-categorie mb-2">Électronique</span>
                        <h5 class="card-title fw-bold">Écouteurs Sans Fil</h5>
                        <p class="prix-produit">799.00 MAD</p>
                        <a href="{{ path('ecommerce_prodDetails', { id: 1 }) }}" class="bouton-details">Voir le produit</a>
                    </div>
                </div>
            </div>

            <!-- Produit 2 -->
            <div class="col">
                <div class="card carte-produit h-100">
                    <img src="item.png" class="card-img-top" alt="Veste en cuir">
                    <div class="card-body">
                        <span class="badge bg-warning etiquette-categorie mb-2">Mode</span>
                        <h5 class="card-title fw-bold">Veste en Cuir Classique</h5>
                        <p class="prix-produit">1 499.00 MAD</p>
                        <a href="{{ path('ecommerce_prodDetails', { id: 2 }) }}" class="bouton-details">Voir le produit</a>
                    </div>
                </div>
            </div>

            <!-- Produit 3 -->
            <div class="col">
                <div class="card carte-produit h-100">
                    <img src="item.png" class="card-img-top" alt="Capteur plante">
                    <div class="card-body">
                        <span class="badge bg-success etiquette-categorie mb-2">Maison & Jardin</span>
                        <h5 class="card-title fw-bold">Capteur de Plantes Intelligent</h5>
                        <p class="prix-produit">349.00 MAD</p>
                        <a href="{{ path('ecommerce_prodDetails', { id: 3 }) }}" class="bouton-details">Voir le produit</a>
                    </div>
                </div>
            </div>

            <!-- Produit 4 -->
            <div class="col">
                <div class="card carte-produit h-100">
                    <img src="item.png" class="card-img-top" alt="Tapis de yoga">
                    <div class="card-body">
                        <span class="badge bg-info etiquette-categorie mb-2">Sport</span>
                        <h5 class="card-title fw-bold">Tapis de Yoga Premium</h5>
                        <p class="prix-produit">299.00 MAD</p>
                        <a href="{{ path('ecommerce_prodDetails', { id: 4 }) }}" class="bouton-details">Voir le produit</a>
                    </div>
                </div>
            </div>

            <!-- Produit 5 -->
            <div class="col">
                <div class="card carte-produit h-100">
                    <img src="item.png" class="card-img-top" alt="Enceinte bluetooth">
                    <div class="card-body">
                        <span class="badge bg-primary etiquette-categorie mb-2">Électronique</span>
                        <h5 class="card-title fw-bold">Enceinte Bluetooth Portable</h5>
                        <p class="prix-produit">599.00 MAD</p>
                        <a href="{{ path('ecommerce_prodDetails', { id: 5 }) }}" class="bouton-details">Voir le produit</a>
                    </div>
                </div>
            </div>

            <!-- Produit 6 -->
            <div class="col">
                <div class="card carte-produit h-100">
                    <img src="item.png" class="card-img-top" alt="Livre développement web">
                    <div class="card-body">
                        <span class="badge bg-danger etiquette-categorie mb-2">Livres</span>
                        <h5 class="card-title fw-bold">Guide du Développement Web</h5>
                        <p class="prix-produit">249.00 MAD</p>
                        <a href="{{ path('ecommerce_prodDetails', { id: 6 }) }}" class="bouton-details">Voir le produit</a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Pied de page -->
    <footer class="pied-page">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="nom-boutique-pied mb-1">🛒 MarocShop</p>
                    <p class="mb-0 small">Des produits de qualité à prix accessibles</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0 small">&copy; 2026 MarocShop. Tous droits réservés.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

{% endblock %}