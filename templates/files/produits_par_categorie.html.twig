{% extends "base.html.twig" %}

{% block title %}{{ categorieSelectionnee.nom }} - MarocShop{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f1f5f9;
        }

        /* Fil d'Ariane */
        .fil-ariane .breadcrumb-item a {
            color: #ea580c;
            text-decoration: none;
            font-weight: 500;
        }

        /* Bannière catégorie */
        .banniere-categorie {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
            border-radius: 16px;
            padding: 3rem;
            color: white;
            margin-bottom: 2rem;
            box-shadow: 0 8px 30px rgba(0,0,0,0.2);
        }

        .titre-categorie {
            font-size: 2.5rem;
            font-weight: 900;
            margin-bottom: 0.75rem;
        }

        .titre-categorie span {
            color: #fdba74;
        }

        .description-categorie {
            color: #cbd5e1;
            font-size: 1rem;
            margin-bottom: 1rem;
        }

        .badge-quantite {
            background: rgba(74, 222, 128, 0.2);
            color: #fdba74;
            border: 1px solid #fdba74;
            padding: 0.4rem 1rem;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.85rem;
        }

        /* Barre de tri */
        .barre-affichage {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .titre-liste-produits {
            font-weight: 700;
            color: #1a1a2e;
            font-size: 1.2rem;
        }

        .bouton-vue {
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            padding: 0.4rem 0.8rem;
            color: #6b7280;
            background: white;
            font-size: 0.85rem;
            transition: all 0.2s;
        }

        .bouton-vue.actif, .bouton-vue:hover {
            border-color: #ea580c;
            color: #ea580c;
            background: #fff7ed;
        }

        /* Cartes Produits */
        .carte-produit {
            border: none;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            overflow: hidden;
        }

        .carte-produit:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 38px rgba(0,0,0,0.15);
        }

        .carte-produit .card-img-top {
            height: 200px;
            object-fit: cover;
        }

        .etiquette-categorie-produit {
            background: linear-gradient(135deg, #ea580c, #c2410c);
            color: white;
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 0.75rem;
        }

        .nom-produit {
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 0.5rem;
        }

        .prix-produit {
            font-weight: 800;
            color: #ea580c;
            font-size: 1.1rem;
        }

        .bouton-voir-produit {
            background: linear-gradient(135deg, #ea580c, #c2410c);
            border: none;
            border-radius: 8px;
            color: white;
            padding: 0.5rem 1.2rem;
            font-weight: 600;
            text-decoration: none;
            transition: opacity 0.2s;
            display: inline-block;
        }

        .bouton-voir-produit:hover {
            opacity: 0.88;
            color: white;
        }

        /* Pagination */
        .pagination .page-link {
            color: #ea580c;
            border-radius: 8px;
            margin: 0 2px;
        }

        .pagination .page-item.active .page-link {
            background-color: #ea580c;
            border-color: #ea580c;
        }

        /* Pied de page */
        .pied-page {
            background: #1a1a2e;
            color: #94a3b8;
            padding: 2rem 0;
            margin-top: 4rem;
        }

        .nom-boutique-pied {
            color: #fdba74;
            font-weight: 700;
            font-size: 1.2rem;
        }
    </style>
{% endblock %}

{% block body %}
    {{ parent() }}

    <!-- Fil d'Ariane -->
    <div class="container mt-4">
        <nav aria-label="fil d'ariane" class="fil-ariane">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="{{ path('ecommerce_homePage') }}">Accueil</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="{{ path('ecommerce_homePage') }}">Catégories</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">{{ categorieSelectionnee.nom }}</li>
            </ol>
        </nav>
    </div>

    <!-- Bannière catégorie -->
    <div class="container my-4">
        <div class="banniere-categorie">
            <h1 class="titre-categorie">
                📂 <span>{{ categorieSelectionnee.nom }}</span>
            </h1>
            <p class="description-categorie">{{ categorieSelectionnee.description }}</p>
            <span class="badge-quantite">{{ categorieSelectionnee.nombreProduits }} produits disponibles</span>
        </div>
    </div>

    <!-- Liste des Produits -->
    <div class="container mb-5">

        <!-- Barre de tri/affichage -->
        <div class="barre-affichage">
            <h3 class="titre-liste-produits">Produits de la catégorie {{ categorieSelectionnee.nom }}</h3>
            <div class="btn-group" role="group">
                <button type="button" class="bouton-vue actif">Grille</button>
                <button type="button" class="bouton-vue">Liste</button>
            </div>
        </div>

        <!-- Grille produits -->
        <div class="row row-cols-1 row-cols-md-3 g-4">
            {% for produit in produitsAffiches %}
                <div class="col">
                    <div class="carte-produit card h-100">
                        <img src="mouse.png" class="card-img-top" alt="{{ produit.nom }}">
                        <div class="card-body">
                            <span class="etiquette-categorie-produit">{{ categorieSelectionnee.nom }}</span>
                            <h5 class="nom-produit">{{ produit.nom }}</h5>
                            <p class="prix-produit">{{ produit.prix }} MAD</p>
                            <a href="{{ path('ecommerce_prodDetails', { id: produit.id }) }}"
                               class="bouton-voir-produit">
                                Voir le produit →
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- Pagination -->
        <nav aria-label="Pagination produits" class="mt-5">
            <ul class="pagination justify-content-center">
                <li class="page-item disabled">
                    <a class="page-link" href="#">Précédent</a>
                </li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item">
                    <a class="page-link" href="#">Suivant</a>
                </li>
            </ul>
        </nav>
    </div>

    <!-- Pied de page -->
    <footer class="pied-page">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="nom-boutique-pied mb-1">🛒 MarocShop</p>
                    <p class="mb-0 small">Des produits de qualité à prix accessibles</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0 small">&copy; 2026 MarocShop. Tous droits réservés.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

{% endblock %}