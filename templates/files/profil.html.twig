{% extends "base.html.twig" %}

{% block title %}Mon Profil - MarocShop{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f1f5f9;
        }

        .carte-profil-lateral {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .entete-profil {
            background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%);
            padding: 2rem;
            text-align: center;
            color: white;
        }

        .avatar-utilisateur {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            border: 4px solid rgba(255,255,255,0.5);
            object-fit: cover;
        }

        .nom-utilisateur {
            font-weight: 700;
            font-size: 1.1rem;
            margin-top: 0.75rem;
            margin-bottom: 0.2rem;
        }

        .email-utilisateur {
            font-size: 0.85rem;
            opacity: 0.85;
        }

        .menu-profil {
            padding: 1.5rem;
        }

        .lien-menu-profil {
            display: block;
            padding: 0.6rem 0.8rem;
            border-radius: 8px;
            color: #374151;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.2s;
            margin-bottom: 0.4rem;
        }

        .lien-menu-profil:hover {
            background-color: #fff7ed;
            color: #ea580c;
        }

        .lien-deconnexion {
            color: #dc2626;
        }

        .lien-deconnexion:hover {
            background-color: #fef2f2;
            color: #dc2626;
        }

        .section-contenu {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            margin-bottom: 1.5rem;
            overflow: hidden;
        }

        .entete-section {
            background: linear-gradient(135deg, #ea580c, #c2410c);
            color: white;
            padding: 1rem 1.5rem;
            font-weight: 700;
            font-size: 1rem;
        }

        .corps-section {
            padding: 1.5rem;
        }

        .etiquette-champ {
            font-weight: 600;
            color: #6b7280;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .valeur-champ {
            color: #1a1a2e;
            font-weight: 500;
        }

        .badge-statut-livre {
            background-color: #ffedd5;
            color: #ea580c;
            font-weight: 600;
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
        }

        .badge-statut-transit {
            background-color: #dbeafe;
            color: #2563eb;
            font-weight: 600;
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
        }

        .badge-statut-traitement {
            background-color: #fef9c3;
            color: #ca8a04;
            font-weight: 600;
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
        }

        .badge-statut-annule {
            background-color: #fee2e2;
            color: #dc2626;
            font-weight: 600;
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
        }

        .carte-commande {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 1rem;
            margin-bottom: 1rem;
        }

        .bouton-modifier {
            background: transparent;
            border: 2px solid #ea580c;
            color: #ea580c;
            border-radius: 8px;
            padding: 0.4rem 1rem;
            font-weight: 600;
            transition: all 0.2s;
        }

        .bouton-modifier:hover {
            background: #ea580c;
            color: white;
        }

        .pied-page {
            background: #1a1a2e;
            color: #94a3b8;
            padding: 2rem 0;
            margin-top: 3rem;
        }

        .nom-boutique-pied {
            color: #fdba74;
            font-weight: 700;
            font-size: 1.2rem;
        }
    </style>
{% endblock %}

{% block body %}
    {{ parent() }}

    <!-- Section Profil -->
    <div class="container my-5">
        <div class="row g-4">

            <!-- Barre Latérale -->
            <div class="col-md-3">
                <div class="carte-profil-lateral">
                    <div class="entete-profil">
                        <img src="profile.png" class="avatar-utilisateur" alt="Photo de profil">
                        <p class="nom-utilisateur">{{ app.user.nomComplet|default('Utilisateur') }}</p>
                        <p class="email-utilisateur">{{ app.user.email|default('') }}</p>
                    </div>
                    <div class="menu-profil">
                        <a href="#informations" class="lien-menu-profil">👤 Mes informations</a>
                        <a href="#commandes" class="lien-menu-profil">📦 Mes commandes</a>
                        <a href="#" class="lien-menu-profil">⚙️ Paramètres</a>
                        <hr>
                        <a href="{{ path('ecommerce_logout') }}" class="lien-menu-profil lien-deconnexion">🚪 Se déconnecter</a>
                    </div>
                </div>
            </div>

            <!-- Contenu Principal -->
            <div class="col-md-9">

                <!-- Informations personnelles -->
                <div class="section-contenu" id="informations">
                    <div class="entete-section">👤 Informations personnelles</div>
                    <div class="corps-section">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <p class="etiquette-champ">Nom complet</p>
                                <p class="valeur-champ">{{ app.user.nomComplet|default('Utilisateur') }}</p>
                            </div>
                            <div class="col-md-6">
                                <p class="etiquette-champ">Adresse e-mail</p>
                                <p class="valeur-champ">{{ app.user.email|default('') }}</p>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <p class="etiquette-champ">Téléphone</p>
                                <p class="valeur-champ">+212 6 12 34 56 78</p>
                            </div>
                            <div class="col-md-6">
                                <p class="etiquette-champ">Membre depuis</p>
                                <p class="valeur-champ">Janvier 2026</p>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-12">
                                <p class="etiquette-champ">Adresse de livraison</p>
                                <p class="valeur-champ">123 Rue Mohammed V, Apt 4B<br>Casablanca, 20000<br>Maroc</p>
                            </div>
                        </div>
                        <button class="bouton-modifier btn">✏️ Modifier le profil</button>
                    </div>
                </div>

                <!-- Historique des commandes -->
                <div class="section-contenu" id="commandes">
                    <div class="entete-section">📦 Historique des commandes</div>
                    <div class="corps-section">

                        <div class="carte-commande">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h6 class="fw-bold mb-1">Commande #CMD-2026-001</h6>
                                    <p class="text-muted small mb-1">Passée le : 10 février 2026</p>
                                    <p class="mb-1 small"><strong>Articles :</strong> Écouteurs Sans Fil, Enceinte Bluetooth</p>
                                    <p class="mb-0 small"><strong>Total :</strong> 1 398.00 MAD</p>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <span class="badge-statut-livre">✓ Livré</span><br>
                                    <a href="#" class="btn btn-sm btn-outline-success mt-2">Voir détails</a>
                                </div>
                            </div>
                        </div>

                        <div class="carte-commande">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h6 class="fw-bold mb-1">Commande #CMD-2026-002</h6>
                                    <p class="text-muted small mb-1">Passée le : 5 février 2026</p>
                                    <p class="mb-1 small"><strong>Articles :</strong> Veste en Cuir Classique</p>
                                    <p class="mb-0 small"><strong>Total :</strong> 1 499.00 MAD</p>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <span class="badge-statut-transit">🚚 En transit</span><br>
                                    <a href="#" class="btn btn-sm btn-outline-primary mt-2">Suivre</a>
                                </div>
                            </div>
                        </div>

                        <div class="carte-commande">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h6 class="fw-bold mb-1">Commande #CMD-2026-003</h6>
                                    <p class="text-muted small mb-1">Passée le : 28 janvier 2026</p>
                                    <p class="mb-1 small"><strong>Articles :</strong> Tapis de Yoga, Capteur Plantes</p>
                                    <p class="mb-0 small"><strong>Total :</strong> 648.00 MAD</p>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <span class="badge-statut-traitement">⏳ En traitement</span><br>
                                    <a href="#" class="btn btn-sm btn-outline-warning mt-2">Voir détails</a>
                                </div>
                            </div>
                        </div>

                        <div class="carte-commande">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h6 class="fw-bold mb-1">Commande #CMD-2026-004</h6>
                                    <p class="text-muted small mb-1">Passée le : 20 janvier 2026</p>
                                    <p class="mb-1 small"><strong>Articles :</strong> Guide du Développement Web</p>
                                    <p class="mb-0 small"><strong>Total :</strong> 249.00 MAD</p>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <span class="badge-statut-annule">✕ Annulé</span><br>
                                    <a href="#" class="btn btn-sm btn-outline-secondary mt-2">Voir détails</a>
                                </div>
                            </div>
                        </div>

                        <!-- Pagination -->
                        <nav aria-label="Pagination commandes" class="mt-3">
                            <ul class="pagination justify-content-center mb-0">
                                <li class="page-item disabled">
                                    <a class="page-link" href="#">Précédent</a>
                                </li>
                                <li class="page-item active">
                                    <a class="page-link" href="#" style="background-color:#ea580c; border-color:#ea580c;">1</a>
                                </li>
                                <li class="page-item"><a class="page-link" href="#">2</a></li>
                                <li class="page-item">
                                    <a class="page-link" href="#">Suivant</a>
                                </li>
                            </ul>
                        </nav>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Pied de page -->
    <footer class="pied-page">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="nom-boutique-pied mb-1">🛒 MarocShop</p>
                    <p class="mb-0 small">Des produits de qualité à prix accessibles</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0 small">&copy; 2026 MarocShop. Tous droits réservés.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

{% endblock %}