{% extends "base.html.twig" %}

{% block title %}{{ produitSelectionne.nom }} - MarocShop{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f1f5f9;
        }

        .image-produit {
            border-radius: 16px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.12);
            object-fit: cover;
            width: 100%;
        }

        .fil-ariane .breadcrumb-item a {
            color: #ea580c;
            text-decoration: none;
        }

        .badge-categorie {
            background: linear-gradient(135deg, #ea580c, #c2410c);
            color: white;
            padding: 0.4rem 1rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .nom-produit-titre {
            font-size: 2rem;
            font-weight: 800;
            color: #1a1a2e;
            line-height: 1.2;
        }

        .prix-produit-detail {
            font-size: 2rem;
            font-weight: 800;
            color: #ea580c;
        }

        .titre-description {
            font-weight: 700;
            color: #374151;
            margin-bottom: 0.5rem;
        }

        .texte-description {
            color: #6b7280;
            line-height: 1.7;
        }

        .champ-quantite {
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            padding: 0.5rem;
            max-width: 100px;
            font-weight: 600;
            text-align: center;
        }

        .champ-quantite:focus {
            border-color: #ea580c;
            box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.15);
        }

        .bouton-ajouter-panier {
            background: linear-gradient(135deg, #ea580c, #c2410c);
            border: none;
            border-radius: 10px;
            color: white;
            padding: 0.8rem 2rem;
            font-weight: 700;
            font-size: 1rem;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .bouton-ajouter-panier:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(234, 88, 12, 0.4);
            color: white;
        }

        .bouton-continuer-achat {
            border: 2px solid #6b7280;
            border-radius: 10px;
            color: #374151;
            padding: 0.8rem 1.5rem;
            font-weight: 600;
            background: transparent;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
        }

        .bouton-continuer-achat:hover {
            border-color: #ea580c;
            color: #ea580c;
        }

        .separateur-info {
            border-top: 1px solid #e5e7eb;
            padding-top: 1.5rem;
            margin-top: 1.5rem;
        }

        .element-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .disponible-badge {
            color: #ea580c;
            font-weight: 600;
        }

        .epuise-badge {
            color: #dc2626;
            font-weight: 600;
        }

        .pied-page {
            background: #1a1a2e;
            color: #94a3b8;
            padding: 2rem 0;
            margin-top: 4rem;
        }

        .nom-boutique-pied {
            color: #fdba74;
            font-weight: 700;
            font-size: 1.2rem;
        }
    </style>
{% endblock %}

{% block body %}
    {{ parent() }}

    <!-- Section Détails du Produit -->
    <div class="container my-5">
        <div class="row g-5">

            <!-- Image du produit -->
            <div class="col-md-6">
                <img src="airbod.png" class="image-produit" alt="{{ produitSelectionne.nom }}">
            </div>

            <!-- Informations du produit -->
            <div class="col-md-6">

                <!-- Fil d'Ariane -->
                <nav aria-label="fil d'ariane" class="fil-ariane mb-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="{{ path('ecommerce_homePage') }}">Accueil</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Détails du produit</li>
                    </ol>
                </nav>

                <span class="badge-categorie mb-3 d-inline-block">{{ produitSelectionne.categorie.nom }}</span>

                <h1 class="nom-produit-titre mb-3">{{ produitSelectionne.nom }}</h1>

                <p class="prix-produit-detail mb-4">{{ produitSelectionne.prix }} MAD</p>

                <div class="mb-4">
                    <h5 class="titre-description">Description</h5>
                    <p class="texte-description">{{ produitSelectionne.description }}</p>
                </div>

                <!-- Formulaire d'ajout au panier -->
                <form action="{{ path('ecommerce_addToCart', { id: produitSelectionne.id }) }}" method="POST">
                    <div class="mb-3">
                        <label for="nombre_articles" class="form-label fw-semibold">Quantité</label>
                        <input type="number"
                               class="form-control champ-quantite"
                               id="nombre_articles"
                               name="quantity"
                               value="1"
                               min="1"
                               max="10">
                    </div>

                    <div class="d-flex gap-3 flex-wrap">
                        <button type="submit" class="bouton-ajouter-panier btn">
                            🛒 Ajouter au panier
                        </button>
                        <a href="{{ path('ecommerce_productsThroughCategory', { id: produitSelectionne.categorie.id }) }}"
                           class="bouton-continuer-achat">
                            Continuer les achats
                        </a>
                    </div>
                </form>

                <!-- Informations supplémentaires -->
                <div class="separateur-info">
                    <div class="element-info">
                        <strong>Disponibilité :</strong>
                        {% if produitSelectionne.quantite > 0 %}
                            <span class="disponible-badge">✓ En stock</span>
                        {% elseif produitSelectionne.quantite == 0 %}
                            <span class="epuise-badge">✕ Épuisé</span>
                        {% endif %}
                    </div>
                    <div class="element-info">
                        <strong>Catégorie :</strong>
                        <span class="text-muted">{{ produitSelectionne.categorie.nom }}</span>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Pied de page -->
    <footer class="pied-page">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="nom-boutique-pied mb-1">🛒 MarocShop</p>
                    <p class="mb-0 small">Des produits de qualité à prix accessibles</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0 small">&copy; 2026 MarocShop. Tous droits réservés.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

{% endblock %}